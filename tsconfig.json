{
  "compilerOptions": {
    "downlevelIteration": true,
    "emitDecoratorMetadata": true,
    "exactOptionalPropertyTypes": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "inlineSourceMap": true,
    "lib": ["dom", "es2021", "dom.iterable"],
    "moduleResolution": "bundler",
    "module": "es2022",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "strict": true,
    // Don't scan the node_modules/@types folder for ambient types.
    // This would force us to have all the types in the dependencies of
    // each library.
    // Instead we'll be explicit about declaring ambient type dependencies
    // using the ///<reference types=""/> syntax.
    "types": [],
    "plugins": [
      {
        "name": "@bazel/tsetse",
        // Both rules below are broken by @bazel/concatjs's frozen tsutils@3.21.0
        // (predates TypeScript 5.9) manually walking the TS AST/checker in ways
        // TS 5.9's internals no longer support. @bazel/concatjs is frozen at
        // 5.8.1 with no newer release, so disable these two lint-only rules:
        // - ban-promise-as-condition: typeChecker.getResolvedSignature() call
        //   crashes ("Debug Failure... should be unreachable").
        // - must-use-promises: tsutils.isExpressionValueUsed() false-positives
        //   on at least one correctly-awaited call
        //   (alert_display_snackbar_container.ts), the only usage of that
        //   pattern in this codebase.
        "disabledRules": ["ban-promise-as-condition", "must-use-promises"]
      }
    ]
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
