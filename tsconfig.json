{
  "compilerOptions": {
    "downlevelIteration": true,
    "emitDecoratorMetadata": true,
    "exactOptionalPropertyTypes": true,
    "experimentalDecorators": true,
    // TypeScript 6.0 errors on options that will be removed in 7.0. Two of the three we
    // hit ("baseUrl" and "moduleResolution=node10") are injected by @bazel/concatjs's
    // create_tsconfig rather than set here, and concatjs 5.8.1 is frozen. Remove this
    // once the migration to rules_js / rules_ts drops concatjs.
    "ignoreDeprecations": "6.0",
    "importHelpers": true,
    "inlineSourceMap": true,
    "lib": ["dom", "es2021", "dom.iterable"],
    "moduleResolution": "bundler",
    "module": "es2022",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "strict": true,
    // Don't scan the node_modules/@types folder for ambient types.
    // This would force us to have all the types in the dependencies of
    // each library.
    // Instead we'll be explicit about declaring ambient type dependencies
    // using the ///<reference types=""/> syntax.
    "types": [],
    "plugins": [
      {
        "name": "@bazel/tsetse",
        // disabled: concatjs pins tsutils to 3.21.0, which predates TS 5.9 and breaks
        // these three rules. ban-promise-as-condition crashes the compiler,
        // must-use-promises misfires on the one awaited call in
        // alert_display_snackbar_container.ts, and ban-expect-truthy-promise crashes
        // under TS 6.0 with "unionTypeParts is not a function". check-return-value
        // stays enabled because it uses syntactic helpers, not the broken APIs.
        "disabledRules": [
          "ban-promise-as-condition",
          "must-use-promises",
          "ban-expect-truthy-promise"
        ]
      }
    ]
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    // Temporary, back to true once the containers move off AsyncPipe in the follow-up PR
    // that restores this flag.
    // AsyncPipe.transform is typed `T | null` whatever its source, so this check rejects
    // all 166 `[x]="obs$ | async"` bindings.
    "strictNullInputTypes": false,
    // Angular 22 starts firing these two, and its changelog suggests silencing them to
    // get through the upgrade. Enabling them here ahead of the bump instead keeps the
    // cleanup separate from the version bump. Both flag a redundant "?." or "??" on an
    // expression the type checker already knows cannot be null or undefined.
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "error",
        "optionalChainNotNullable": "error"
      }
    }
  }
}
